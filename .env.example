# ==============================================================================
# Telegram Invite Tracker Bot — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the required values.
# Lines starting with # are comments.
# ==============================================================================

# ==================== Required ====================
# Telegram bot token from @BotFather (REQUIRED)
BOT_TOKEN=your_bot_token_here

# Telegram user ID of the bot owner/superadmin (REQUIRED)
BOT_OWNER_ID=123456789

# ==================== Optional: Super Admins ====================
# Comma-separated list of Telegram user IDs with super admin access
SUPER_ADMIN_IDS=

# ==================== Database ====================
# PostgreSQL connection URL with asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/invite_tracker

# Log all SQL queries (True/False) — only enable in development
DATABASE_ECHO=False

# ==================== Redis ====================
# Redis connection URL for caching, rate limiting, and pub/sub
REDIS_URL=redis://localhost:6379/0

# ==================== Bot Mode ====================
# Use webhook mode instead of long polling (True/False)
USE_WEBHOOK=False

# Webhook settings (required if USE_WEBHOOK=True)
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8443

# ==================== Logging ====================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Directory for log files
LOG_DIR=logs

# Use JSON format for log output (True/False)
LOG_JSON=True

# ==================== Environment ====================
# Environment name: development, staging, production
ENVIRONMENT=development

# Enable debug mode (True/False)
DEBUG=False

# ==================== Monitoring ====================
# Enable Prometheus metrics endpoint (True/False)
ENABLE_METRICS=True

# Port for Prometheus metrics
METRICS_PORT=9090

# Port for health check endpoint
HEALTH_CHECK_PORT=8080

# ==================== Timezone ====================
# Default timezone for reports (IANA format, e.g., Asia/Tashkent)
DEFAULT_TIMEZONE=UTC
